{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "outputDirectory": ".",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    { "source": "/product", "destination": "/#product", "permanent": false },
    { "source": "/platform", "destination": "/#platform", "permanent": false },
    { "source": "/teams", "destination": "/#casework", "permanent": false },
    { "source": "/casework", "destination": "/#casework", "permanent": false },
    { "source": "/future", "destination": "/#company", "permanent": false },
    { "source": "/company", "destination": "/#company", "permanent": false },
    { "source": "/contact", "destination": "/#contact", "permanent": false }
  ],
  "rewrites": [
    { "source": "/:path((?!public/|styles\\.css|script\\.js|favicon\\.ico).*)", "destination": "/" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; img-src 'self' data:; style-src 'self'; script-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; form-action 'self' mailto:"
        }
      ]
    }
  ]
}
